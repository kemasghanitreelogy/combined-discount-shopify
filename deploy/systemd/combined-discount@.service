# /etc/systemd/system/combined-discount@.service
#
# Combined Discount Shopify app, one instance per blue/green slot: %i is the
# port (3200 or 3201). nginx sends traffic to whichever slot
# /etc/nginx/conf.d/combined-discount-upstream.conf names; the deploy script
# starts the idle slot on the new release, health-checks it, flips nginx with a
# graceful reload, then stops the old slot — so no request ever waits on a
# restart. Each slot runs the release its /opt/combined-discount/slots/%i
# symlink points at. Stateless (sessions live in Neon), so no writable path.
[Unit]
Description=Combined Discount Shopify app, slot %i (127.0.0.1:%i, behind nginx)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=combined-discount
Group=combined-discount
WorkingDirectory=/opt/combined-discount/slots/%i
EnvironmentFile=/etc/combined-discount/env
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=%i
ExecStart=/usr/bin/node ./node_modules/.bin/react-router-serve ./build/server/index.js
Restart=always
RestartSec=3
TimeoutStopSec=20

# Resource ceiling: the box is shared with the Treelogy services, so a leak here
# must not take them down with it. Both slots run together only during a switch.
MemoryHigh=640M
MemoryMax=768M
TasksMax=256

# Hardening. MemoryDenyWriteExecute is deliberately absent: V8's JIT needs W+X pages.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

[Install]
WantedBy=multi-user.target
