# /etc/systemd/system/combined-discount.service
#
# Combined Discount Shopify app — 127.0.0.1:3200, behind nginx at
# discount.treelogy-services.my.id. Code lives in /opt/combined-discount/current,
# a symlink the deploy script swaps atomically; the service is stateless (the
# session store is Neon Postgres), so it gets no writable path at all.
[Unit]
Description=Combined Discount Shopify app (127.0.0.1:3200, behind nginx)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=combined-discount
Group=combined-discount
WorkingDirectory=/opt/combined-discount/current
EnvironmentFile=/etc/combined-discount/env
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3200
ExecStart=/usr/bin/node ./node_modules/.bin/react-router-serve ./build/server/index.js
Restart=always
RestartSec=3
TimeoutStopSec=20

# Resource ceiling: the box is shared with the Treelogy services, so a leak here
# must not take them down with it.
MemoryHigh=640M
MemoryMax=768M
TasksMax=256

# Hardening. MemoryDenyWriteExecute is deliberately absent: V8's JIT needs W+X pages.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

[Install]
WantedBy=multi-user.target
