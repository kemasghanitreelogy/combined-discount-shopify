# /etc/combined-discount/env — root:combined-discount, mode 640.
# NODE_ENV, HOST and PORT are set by the systemd unit, not here.

SHOPIFY_APP_URL=https://discount.treelogy-services.my.id
SHOPIFY_API_KEY=fb959e692364c4077d75bd1908f8c38f
SHOPIFY_API_SECRET=
SCOPES=write_products,write_metaobjects,write_metaobject_definitions,write_discounts,write_customers,read_orders

# Supabase project `combined-discount` (ap-southeast-1), dedicated role + schema,
# through the Supavisor session pooler — the VPS has no IPv6, and the direct
# db.<ref>.supabase.co host is IPv6-only. Keep sslmode=require; connection_limit
# stays low because both blue/green slots hold a pool during a switch.
# postgresql://combined_discount.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require&schema=combined_discount&connection_limit=5
DATABASE_URL=

# Shared secret for /api/admin/customers and the shop it acts on.
ADMIN_API_SECRET=
ADMIN_SHOP_DOMAIN=

# Optional: storefront custom domain, if the shop uses one for auth.
# SHOP_CUSTOM_DOMAIN=
