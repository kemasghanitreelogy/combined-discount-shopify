# /etc/combined-discount/env — root:combined-discount, mode 640.
# NODE_ENV, HOST and PORT are set by the systemd unit, not here.

SHOPIFY_APP_URL=https://discount.treelogy-services.my.id
SHOPIFY_API_KEY=fb959e692364c4077d75bd1908f8c38f
SHOPIFY_API_SECRET=
SCOPES=write_products,write_metaobjects,write_metaobject_definitions,write_discounts,write_customers,read_orders

# Neon → Connect → Prisma. Keep ?sslmode=require.
DATABASE_URL=

# Shared secret for /api/admin/customers and the shop it acts on.
ADMIN_API_SECRET=
ADMIN_SHOP_DOMAIN=

# Optional: storefront custom domain, if the shop uses one for auth.
# SHOP_CUSTOM_DOMAIN=
