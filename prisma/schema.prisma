// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

/// One row per discount the Combined Discount app manages.
///
/// `campaignKey` is embedded in the discount's function-configuration metafield
/// and namespaces that campaign's counters inside each customer's state
/// metafield, so the Function never needs to know its own discount ID (the
/// Function input schema does not expose one).
model DiscountCampaign {
  id          String  @id @default(cuid())
  shop        String
  campaignKey String
  discountId  String
  method      String
  title       String
  code        String?

  /// JSON arrays of product / variant GIDs whose purchase qualifies a customer
  /// for the purchase-history gate. Empty means "any purchase qualifies".
  qualifyingProductIds String @default("[]")
  qualifyingVariantIds String @default("[]")

  /// Mirrors of the metafield config, so the webhook can decide what to project
  /// without re-reading every discount from the Admin API on each order.
  maxOrdersPerCustomer Int?
  purchasedBefore      String?
  archived             Boolean @default(false)

  /// Cutoff the last segment backfill actually ran against. If it drifts from
  /// `purchasedBefore` the projected dates are stale and the merchant is told
  /// to re-run — the gate fails closed either way, but silently.
  backfilledCutoff String?
  backfilledAt     DateTime?

  /// Klaviyo list that customers who redeem this discount are added to.
  /// Null keeps them out of any list; properties and events still sync.
  klaviyoListId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shop, campaignKey])
  @@unique([shop, discountId])
  @@index([shop, archived])
  @@index([shop, title])
  @@index([shop, code])
}

/// Ledger of redemptions. This is the source of truth for "works for N separate
/// orders only"; the customer metafield is a projection of it that the Function
/// can read. The unique constraint makes webhook replays idempotent.
model DiscountRedemption {
  id          String   @id @default(cuid())
  shop        String
  campaignKey String
  customerId  String
  orderId     String
  orderedAt   DateTime
  createdAt   DateTime @default(now())

  @@unique([shop, campaignKey, orderId])
  @@index([shop, campaignKey, customerId])
}

/// Cache of each customer's projected purchase history, so the webhook can
/// recompute the state metafield without re-walking order history.
model CustomerPurchaseFact {
  id              String    @id @default(cuid())
  shop            String
  customerId      String
  firstPurchaseAt DateTime?
  /// JSON object: { "<campaignKey>": "YYYY-MM-DD" }
  qualifiedAt     String    @default("{}")
  updatedAt       DateTime  @updatedAt

  @@unique([shop, customerId])
}

/// Transactional outbox for pushes to external systems (Klaviyo today).
///
/// The webhook writes a row in the same transaction as the ledger and returns;
/// a worker delivers it with retries. Profile jobs carry no data — they say
/// "sync this customer" and the worker reads the ledger at send time — so
/// bursts coalesce into one row and delivery order does not matter.
model SyncJob {
  id          String    @id @default(cuid())
  shop        String
  /// klaviyo.profile | klaviyo.event | klaviyo.resync
  kind        String
  /// profile:<customer> | event:<campaignKey>:<order> | resync:<YYYY-MM-DD>
  dedupeKey   String
  customerId  String?
  campaignKey String?
  orderId     String?
  /// pending | done | dead
  status      String    @default("pending")
  /// Bumped on every re-enqueue; a worker only completes the version it claimed.
  version     Int       @default(1)
  attempts    Int       @default(0)
  runAt       DateTime  @default(now())
  lockedUntil DateTime?
  lastError   String?
  doneAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([shop, dedupeKey])
  @@index([status, runAt])
}
